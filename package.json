{
  "name": "@peeym/responder-handler",
  "version": "0.4.0",
  "description": "Shared form handler: Make.com → (Responder / Smoove / ActiveTrail / ...) + CRM lead-capture. Provider-agnostic mailing layer. Used by icf-astro, efitzur, storm-eye, scenario, differentiation, tourism, wosh.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/responder.d.ts",
      "default": "./dist/api/responder.js"
    },
    "./client": {
      "types": "./dist/lib/client.d.ts",
      "default": "./dist/lib/client.js"
    },
    "./registry": {
      "types": "./dist/lib/registry.d.ts",
      "default": "./dist/lib/registry.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/peeym/responder-handler.git"
  },
  "author": "peeym + efitzur",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {},
  "peerDependencies": {
    "@vercel/node": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
